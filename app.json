{
  "expo": {
    "name": "Tagit",
    "slug": "tag",
    "version": "2.1.0",
    "scheme": "tagit",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A09",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tagit.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Tagit opens straight to the camera so you can scan someone's code and add them instantly.",
        "NSPhotoLibraryUsageDescription": "Pick a photo for your Tagit card.",
        "LSApplicationQueriesSchemes": [
          "snapchat",
          "instagram",
          "tiktok",
          "twitter",
          "whatsapp"
        ],
        "NFCReaderUsageDescription": "Tagit reads NFC stickers and wristbands so you can check in with a tap instead of the camera."
      },
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF"
        ]
      },
      "associatedDomains": [
        "applinks:tagit.app"
      ]
    },
    "android": {
      "package": "com.tagit.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.NFC"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0A0A09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tagit.app",
              "pathPrefix": "/u"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tagit.app",
              "pathPrefix": "/e"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Tagit opens straight to the camera so you can scan someone's code and add them instantly.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo for your Tagit card."
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A09"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92202ff1-be26-4d19-adb9-29eca1b05daa"
      }
    },
    "owner": "relmxdgamer",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/92202ff1-be26-4d19-adb9-29eca1b05daa"
    }
  }
}
