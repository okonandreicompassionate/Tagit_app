{
  "expo": {
    "name": "Tag",
    "slug": "tag",
    "version": "0.1.0",
    "scheme": "tag",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tag.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Tag opens straight to the camera so you can scan someone's code and add them instantly.",
        "NSPhotoLibraryUsageDescription": "Pick a photo for your Tag card.",
        "LSApplicationQueriesSchemes": [
          "snapchat",
          "instagram",
          "tiktok",
          "twitter",
          "whatsapp"
        ]
      }
    },
    "android": {
      "package": "com.tag.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFC00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Tag opens straight to the camera so you can scan someone's code and add them instantly.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a photo for your Tag card."
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "92202ff1-be26-4d19-adb9-29eca1b05daa"
      }
    },
    "owner": "relmxdgamer"
  }
}
