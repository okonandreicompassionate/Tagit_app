# Leave these unset and the app runs fully offline against src/lib/mock.ts —
# useful for a solo demo, but two phones can't resolve each other's codes.
#
# To go live: create a Supabase project, run supabase/schema.sql in the SQL
# editor, then copy the values below into a .env file.
#
# Use the PUBLISHABLE key (sb_publishable_…) or the legacy anon JWT — both work.
# NEVER the service_role / secret key: EXPO_PUBLIC_* values are inlined into the
# app bundle in plain text, and service_role bypasses every RLS policy.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
