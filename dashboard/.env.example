# Copy to .env.local for local dev. In Vercel, set these as Project ->
# Settings -> Environment Variables — never commit real values.

# From Supabase: Project Settings -> API -> Project URL
SUPABASE_URL=https://sqwpgyoosurewekiwipt.supabase.co

# From Supabase: Project Settings -> API -> service_role key (secret!)
# This key bypasses row-level security entirely. It must only ever live in
# server environment variables — never in a NEXT_PUBLIC_* var, never in
# client code, never in the Expo app.
SUPABASE_SERVICE_ROLE_KEY=

# Which Supabase billing plan this project is on. Only changes which limit
# numbers the Database page shows as the ceiling for its usage bars.
SUPABASE_PLAN=free

# One shared password that gates the whole dashboard. Anyone with it can see
# and act on real user data, so treat it like a production secret.
ADMIN_PASSWORD=

# Random 32+ char string used to sign the admin session cookie. Generate one
# with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
